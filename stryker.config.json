{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": ["src/queue/**/*.ts", "src/ui/format.ts", "src/plex/mapping.ts"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "reporters": ["clear-text", "progress"],
  "ignorePatterns": [".claude", ".mcp.json", "dist", "coverage"]
}
